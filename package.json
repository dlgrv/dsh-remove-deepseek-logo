{
  "name": "dsh-remove-deepseek-logo",
  "version": "1.1.1",
  "description": "DeepSeek Harness plugin: removes the logo, brand name, version string, and the conversation hero fish from the sidebar",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "branding",
    "logo",
    "sidebar",
    "hide-logo",
    "customization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlgrv/dsh-remove-deepseek-logo.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/preview.png"
  ],
  "scripts": {
    "test": "node --test"
  },
  "homepage": "https://github.com/dlgrv/dsh-remove-deepseek-logo#readme",
  "bugs": {
    "url": "https://github.com/dlgrv/dsh-remove-deepseek-logo/issues"
  }
}
