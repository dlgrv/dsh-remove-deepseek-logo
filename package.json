{
  "name": "remove-deepseek-logo",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: removes the logo, brand name, local-build label, version, and the conversation hero fish from the sidebar",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "branding",
    "logo",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlgrv/remove-deepseek-logo.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
